          "refId": "B",
          "expr": "sum by (device, interface) (rate(mikrotik_interface_tx_packets_total{device=~\"$device\",interface=~\"$interface\"}[$__rate_interval]))",
          "editorMode": "code",
          "legendFormat": "Aus {{device}} {{interface}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "min": null,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
