          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "sum by (device, interface) (rate({__name__=~\"mikrotik_interface_tx_errors_total\",device=~\"$device\",interface=~\"$interface\"}[$__rate_interval]))",
          "editorMode": "code",
