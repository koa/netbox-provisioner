      "title": "Verworfene Pakete",
      "description": "Verworfene Pakete pro Sekunde, beim Empfang (Ein, nach unten) und beim Senden (Aus). Bei Ethernet-Ports zählt der Port selbst (/interface/ethernet: rx-drop und rx-overflow, tx-drop), sonst /interface; nur wo RouterOS sie meldet.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (device, interface) (rate({__name__=~\"mikrotik_ethernet_rx_(drops|overflows)_total\",device=~\"$device\",interface=~\"$interface\"}[$__rate_interval])) or sum by (device, interface) (rate({__name__=~\"mikrotik_interface_rx_drops_total\",device=~\"$device\",interface=~\"$interface\"}[$__rate_interval]))",
          "editorMode": "code",
          "legendFormat": "Ein {{device}} {{interface}}",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum by (device, interface) (rate({__name__=~\"mikrotik_ethernet_tx_drops_total\",device=~\"$device\",interface=~\"$interface\"}[$__rate_interval])) or sum by (device, interface) (rate({__name__=~\"mikrotik_interface_tx_drops_total\",device=~\"$device\",interface=~\"$interface\"}[$__rate_interval]))",
          "editorMode": "code",
          "legendFormat": "Aus {{device}} {{interface}}",
