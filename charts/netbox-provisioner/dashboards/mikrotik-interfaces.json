    {
      "type": "timeseries",
      "id": 22,
      "title": "Fehler",
      "description": "Fehlerhafte Pakete pro Sekunde: beim Empfang (Ein, nach unten) Prüfsummenfehler eines Ethernet-Ports (FCS: Kabel oder Stecker) und die Fehler von /interface, beim Senden (Aus) die Fehler von /interface und Kollisionen (Duplex falsch); nur wo RouterOS sie meldet.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (device, interface) (rate({__name__=~\"mikrotik_ethernet_rx_fcs_errors_total\",device=~\"$device\",interface=~\"$interface\"}[$__rate_interval]))",
          "editorMode": "code",
          "legendFormat": "Ein FCS {{device}} {{interface}}",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum by (device, interface) (rate({__name__=~\"mikrotik_interface_rx_errors_total\",device=~\"$device\",interface=~\"$interface\"}[$__rate_interval]))",
          "editorMode": "code",
          "legendFormat": "Ein {{device}} {{interface}}",
          "range": true,
          "instant": false
        },
