---
source: netbox-model/src/graphql/netbox/tests.rs
expression: operation.query
snapshot_kind: text
---
query FetchTopology {
  device_list {
    id
    name
    primary_ip4 {
      id
    }
    primary_ip6 {
      id
    }
    role {
      slug
    }
    interfaces {
      id
      name
      label
      ip_addresses {
        id
      }
      enabled
      type
      bridge {
        id
      }
      tags {
        slug
      }
      untagged_vlan {
        id
      }
      tagged_vlans {
        id
      }
      poe_mode
    }
    frontports {
      id
      name
      rear_port {
        id
      }
    }
    rearports {
      id
      name
    }
    platform {
      name
    }
    tenant {
      id
    }
    location {
      tenant {
        id
      }
    }
    site {
      tenant {
        id
      }
    }
    serial
    custom_field_data
  }
  tenant_list {
    id
  }
  cable_list {
    id
    a_terminations {
      __typename
      ... on InterfaceType {
        id
      }
      ... on FrontPortType {
        id
      }
      ... on RearPortType {
        id
      }
    }
    b_terminations {
      __typename
      ... on InterfaceType {
        id
      }
      ... on FrontPortType {
        id
      }
      ... on RearPortType {
        id
      }
    }
  }
  l2vpn_list {
    id
    name
    type
    identifier
    terminations {
      assigned_object {
        __typename
        ... on InterfaceType {
          id
        }
        ... on VLANType {
          id
        }
      }
    }
  }
  wireless_lan_group_list {
    id
    custom_fields
    name
    wireless_lans {
      id
      ssid
      auth_type
      auth_psk
      vlan {
        id
      }
    }
  }
  vlan_group_list {
    id
    name
    vlans {
      id
      name
      vid
    }
  }
  ip_address_list {
    id
    address
  }
  prefix_list {
    id
    prefix
  }
  ip_range_list {
    id
    role {
      slug
    }
    start_address
    end_address
  }
}
