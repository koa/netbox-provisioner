    primary_ip4: IPAddressFilter
    primary_ip4_id: ID
    primary_ip6: IPAddressFilter
    primary_ip6_id: ID
    rack: RackFilter
    rack_id: ID
    rear_port_count: IntFilterLookup
    rear_ports: RearPortFilter
